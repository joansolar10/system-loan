# Server
PORT=3000
NODE_ENV=development

# Database - SUPABASE (Recomendado - más fácil de configurar)
# Obtén tu DATABASE_URL desde: https://supabase.com/dashboard/project/_/settings/database
# En "Connection string" selecciona "URI" y copia la connection string
USE_SUPABASE=true
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Database - PostgreSQL Local (Alternativa - si USE_SUPABASE=false)
# Descomentar estas líneas si quieres usar PostgreSQL local
# USE_SUPABASE=false
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=loan_management
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Admin por defecto (para seed)
ADMIN_EMAIL=admin@loans.com
ADMIN_PASSWORD=Admin123!

# RENIEC API (reemplazar con API real si está disponible)
RENIEC_API_URL=https://api.apis.net.pe/v1/dni
RENIEC_API_TOKEN=your-reniec-api-token

# Cache
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Declaración Jurada
DDJJ_THRESHOLD_1=5000
DDJJ_THRESHOLD_2=10000
